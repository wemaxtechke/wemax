generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
}

enum ProductCategory {
  Electronics
  Furniture
  HomeAppliances   @map("Home Appliances")
  KitchenAppliances @map("Kitchen Appliances")
  Instruments
}

enum OrderDeliveryStatus {
  Pending
  Processing
  Shipped
  Delivered
  Cancelled
}

enum PaymentStatus {
  Pending
  Paid
}

enum ShippingCarrier {
  G4S
  ParcelGrid        @map("Parcel Grid")
  FargoWells        @map("Fargo wells")
  ShuttlesAndBus    @map("Shuttles and bus services")
}

enum MessageSenderRole {
  admin
  customer
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String?
  phone        String
  role         UserRole  @default(customer)
  googleId     String?   @unique
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wishlistItems    WishlistItem[]
  cartProductLines CartProductLine[]
  cartPackageLines CartPackageLine[]
  orders           Order[]
  reviews          Review[]
  chat             Chat?
  productsCreated  Product[]         @relation("ProductCreator")
  sentMessages     Message[]
}

model WishlistItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CartProductLine {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int     @default(1)
  price     Float
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CartPackageLine {
  id        Int     @id @default(autoincrement())
  userId    Int
  packageId Int
  quantity  Int     @default(1)
  price     Float
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  description      String           @db.Text
  category         ProductCategory
  subCategory      String
  brand            String           @default("")
  newPrice         Float
  oldPrice         Float?
  freeShipping     Boolean          @default(false)
  stock            Int              @default(0)
  locationShipping Json?
  averageRating    Float            @default(0)
  reviewsCount     Int              @default(0)
  isFeatured       Boolean          @default(false)
  isFlashDeal      Boolean          @default(false)
  createdById      Int?
  createdByEmail   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdBy       User?              @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  images          ProductImage[]
  specifications  ProductSpec[]
  packageItems    PackageItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartLines       CartProductLine[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  publicId  String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        Int     @id @default(autoincrement())
  productId Int
  key       String
  value     String  @db.Text
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Package {
  id            Int       @id @default(autoincrement())
  name          String
  description   String    @db.Text
  totalPrice    Float
  oldTotalPrice Float?
  freeShipping  Boolean   @default(false)
  category      String    @default("")
  tag           String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         PackageItem[]
  images        PackageImage[]
  cartLines     CartPackageLine[]
  orderPackages OrderPackageLine[]
}

model PackageItem {
  id        Int     @id @default(autoincrement())
  packageId Int
  productId Int
  quantity  Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PackageImage {
  id        Int     @id @default(autoincrement())
  packageId Int
  url       String
  publicId  String?
  sortOrder Int     @default(0)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Order {
  id                   Int                 @id @default(autoincrement())
  customerId           Int
  shipName             String
  shipPhone            String
  shipCity             String
  shipRegion           String
  shipAddressLine      String              @db.Text
  shippingLocation     String
  shippingCarrier      ShippingCarrier?
  shippingCost         Float
  subtotal             Float
  total                Float
  paymentMethod        String              @default("bank")
  paymentPaybill       String?
  paymentAccount       String?
  paymentProofUrl      String?
  paymentProofPublicId String?
  paymentPaidAt        DateTime?
  paymentStatus        PaymentStatus       @default(Pending)
  status               OrderDeliveryStatus @default(Pending)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  customer User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  packages OrderPackageLine[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model OrderPackageLine {
  id        Int     @id @default(autoincrement())
  orderId   Int
  packageId Int
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
}

model ShippingRate {
  id                  Int             @id @default(autoincrement())
  carrier             ShippingCarrier
  locationName        String
  regionCode          String?
  price               Float
  isDefault           Boolean         @default(false)
  allowCashOnDelivery Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model FlashSaleSettings {
  id        Int      @id @default(autoincrement())
  hours     Int      @default(1)
  minutes   Int      @default(45)
  seconds   Int      @default(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  title     String?
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model Chat {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  lastMessageAt  DateTime @default(now())
  unreadForAdmin Int      @default(0)
  unreadForUser  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id         Int               @id @default(autoincrement())
  chatId     Int
  senderRole MessageSenderRole
  senderId   Int
  content    String            @db.Text
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
}

model MessageAttachment {
  id        Int     @id @default(autoincrement())
  messageId Int
  url       String
  publicId  String?
  type      String?
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
