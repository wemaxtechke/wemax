PORT=5000

# MySQL (Prisma). Replace YOUR_MYSQL_USERNAME and YOUR_MYSQL_PASSWORD with real credentials.
# URL-encode special characters in the password (e.g. @ → %40).
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://YOUR_MYSQL_USERNAME:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/wemax"

JWT_SECRET=your_jwt_secret_key

# Public URL of this API (used in image URLs returned to the client). No trailing slash.
API_PUBLIC_URL=http://localhost:5000
# Optional: absolute or relative path for uploaded files (default: ./uploads under Back-End)
# UPLOADS_DIR=./uploads

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CLIENT_URL=http://localhost:5173
